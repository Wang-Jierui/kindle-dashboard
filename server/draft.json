{
  "version": 1,
  "defaultPage": "today",
  "pages": [
    {
      "id": "today",
      "body": {
        "type": "column",
        "gap": 32,
        "children": [
          {
            "type": "text",
            "role": "title",
            "text": "今日概览"
          },
          {
            "type": "text",
            "role": "caption",
            "text": "示例页面 · 由局域网服务端发布"
          },
          {
            "type": "row",
            "gap": 32,
            "weights": [
              1,
              2
            ],
            "children": [
              {
                "type": "image",
                "src": "weather.png",
                "aspect": 1.3,
                "alt": "晴间多云图标"
              },
              {
                "type": "column",
                "gap": 10,
                "children": [
                  {
                    "type": "text",
                    "role": "heading",
                    "text": "天气"
                  },
                  {
                    "type": "text",
                    "role": "value",
                    "text": "22°C"
                  },
                  {
                    "type": "text",
                    "text": "晴间多云，降雨概率 30%",
                    "maxLines": 2
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "role": "heading",
            "text": "今日安排"
          },
          {
            "type": "text",
            "text": "10:00  周会\n14:30  整理阅读清单",
            "maxLines": 2
          },
          {
            "type": "row",
            "gap": 20,
            "children": [
              {
                "type": "button",
                "id": "refresh",
                "label": "刷新",
                "style": "primary",
                "action": {
                  "type": "refresh"
                }
              },
              {
                "type": "button",
                "id": "agenda",
                "label": "查看日程",
                "action": {
                  "type": "openPage",
                  "page": "agenda"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "agenda",
      "body": {
        "type": "column",
        "gap": 28,
        "children": [
          {
            "type": "text",
            "role": "title",
            "text": "日程"
          },
          {
            "type": "text",
            "role": "heading",
            "text": "上午"
          },
          {
            "type": "text",
            "text": "10:00  周会\n11:30  整理会议记录",
            "maxLines": 2
          },
          {
            "type": "text",
            "role": "heading",
            "text": "下午"
          },
          {
            "type": "text",
            "text": "14:30  整理阅读清单\n17:00  回顾今日待办",
            "maxLines": 2
          },
          {
            "type": "button",
            "id": "back",
            "label": "返回今日概览",
            "action": {
              "type": "openPage",
              "page": "today"
            }
          }
        ]
      }
    }
  ]
}
